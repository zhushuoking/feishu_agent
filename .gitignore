# ---- 凭证与本地配置（绝不提交）----
.env
key.txt
*.key
key.*

# ---- 虚拟环境 ----
.venv/
venv/

# ---- 数据库与运行时产物 ----
*.db
*.db-shm
*.db-wal
*.sqlite3
# SQLite 的临时回滚日志，机器人运行时会瞬间出现又消失，
# 不加这条会让 git add -A 撞上 "unable to index file"
*-journal
*.log

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 编辑器 ----
.idea/
.vscode/
*.swp

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

.local/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
logs/
backups/
config/*_verified.json
