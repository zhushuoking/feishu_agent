# 飞书自建应用凭证（开发者后台 → 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 现在还没用到，后面做免签校验/数据库时再填
DEFAULT_TIMEZONE=Asia/Shanghai
# 不填就用项目目录下的 task_agent.db；换库时填绝对路径
# DATABASE_URL=sqlite:///./task_agent.db

# 确认卡片行为（Day 9）
# CARD_AUTO_PUSH=1   识别出候选后自动推卡片；设 0 只落库不推（调提示词时用）
# CARD_TARGET=auto   auto=先私聊发起人、失败回落群；dm=只私聊；chat=只发群
CARD_AUTO_PUSH=1
CARD_TARGET=auto

# 大模型服务（OpenAI 兼容接口，只填 Base URL 到 /v1 这一层）
# DeepSeek  : https://api.deepseek.com/v1        model=deepseek-chat
# 阿里百炼  : https://dashscope.aliyuncs.com/compatible-mode/v1   model=qwen-plus
# 智谱      : https://open.bigmodel.cn/api/paas/v4                model=glm-4-flash
# 本地Ollama: http://localhost:11434/v1          model=qwen2.5:3b   key 随便填
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT=30

# 权限（Day 10）
# 管理员 open_id，逗号分隔。管理员可以对任何任务执行任何动作，用于兜底。
# 不填就只有「负责人」和「发起人」两种身份。
# AGENT_ADMIN_OPEN_IDS=ou_xxx,ou_yyy
# taskctl.py 不带 --as 时默认用谁的身份（一般填自己的 open_id）
# AGENT_DEFAULT_OPERATOR=ou_xxx

# 日报与提醒（Day 12）
# 每天几点生成日报：09:00 之后才规划，半夜启动不会立刻推
DIGEST_SEND_HOUR=9
# 免打扰时段：22:00-08:00 不发，**延后**不是丢弃
QUIET_START_HOUR=22
QUIET_END_HOUR=8
# 补发时限：超过 6 小时的旧通知直接放弃，早上 9 点的提醒下午 4 点才发等于骂人
DIGEST_MAX_DELAY_HOURS=6
# 日报每类（已逾期/今天/明天）最多列几条，超出显示「还有 N 条」
DIGEST_MAX_PER_SECTION=4
# worker.py 的扫描间隔（秒）
WORKER_INTERVAL_SECONDS=60

# 状态变更即时通知（Day 13）
# 1=在卡片回调里起后台线程立刻发；0=只入队，等 worker 下一轮发（测试用）
EVENT_FLUSH_IMMEDIATE=1

# 到期前 24 小时提醒 / 逾期提醒（设计文档 12.3）
# 到期提醒：每任务每期限一次，改了截止时间会重新提醒
# 逾期提醒：首次逾期发一次，之后每 N 个工作日再发；周末不催
# 两个都走发件箱，受上面的免打扰时段约束
# 注意：一条「明天 9 点截止」的任务，当天日报和到期提醒会各提一次，
# 这是设计文档 12.3 就分开列的两类事件；嫌吵可以把其中一个设 0
DUE_REMINDER_ENABLED=1
OVERDUE_REMINDER_ENABLED=1
OVERDUE_INTERVAL_WORKDAYS=2

# 旧卡片同步（Day 14）
# 1=状态变的时候顺手把这条任务的历史卡片都刷成最新；0=只更新被点的那张
# 关掉只在排障时用：关了就回到「往上翻全是旧状态」的老样子
CARD_SYNC_ENABLED=1
# 刷新后的旧卡上要不要加一句说明，留空=不加（推荐留空）
# 加的话写一句人话，比如「这张卡是历史消息，已同步」
CARD_SYNC_HINT=
