# 飞书自建应用凭证（开发者后台 → 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 目标群 chat_id，用英文逗号分隔。空名单默认拦截所有群。
# 停用名单优先于白名单。
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_DISABLED_CHAT_IDS=
# 项目经理的群内业务授权。每项格式为 群chat_id:用户open_id，用英文逗号分隔。
FEISHU_CHAT_MANAGER_BINDINGS=
# 各群新任务的默认验收人，格式同上。未配置时使用发起人。现有任务保留原验收人。
FEISHU_CHAT_REVIEWER_BINDINGS=

# 现在还没用到，后面做免签校验/数据库时再填
DEFAULT_TIMEZONE=Asia/Shanghai
# 不填就用项目目录下的 task_agent.db；换库时填绝对路径
# DATABASE_URL=sqlite:///./task_agent.db

# 确认卡片行为（Day 9）
# CARD_AUTO_PUSH=1   识别出候选后自动推卡片；设 0 只落库不推（调提示词时用）
# 确认、处理、验收与提醒统一在机器人私聊中发送
CARD_AUTO_PUSH=1

# 大模型服务（OpenAI 兼容接口，只填 Base URL 到 /v1 这一层）
# DeepSeek  : https://api.deepseek.com/v1        model=deepseek-chat
# 阿里百炼  : https://dashscope.aliyuncs.com/compatible-mode/v1   model=qwen-plus
# 智谱      : https://open.bigmodel.cn/api/paas/v4                model=glm-4-flash
# 本地Ollama: http://localhost:11434/v1          model=qwen2.5:3b   key 随便填
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT=30

# 权限（Day 10）
# 管理员 open_id，逗号分隔。管理员可以对任何任务执行任何动作，用于兜底。
# 不填就只有「负责人」和「发起人」两种身份。
# AGENT_ADMIN_OPEN_IDS=ou_xxx,ou_yyy
# taskctl.py 不带 --as 时默认用谁的身份（一般填自己的 open_id）
# AGENT_DEFAULT_OPERATOR=ou_xxx

# 日报与提醒（Day 12）
# 每天几点生成日报：09:00 之后才规划，半夜启动不会立刻推
DIGEST_SEND_HOUR=9
# 免打扰时段：22:00-08:00 不发，**延后**不是丢弃
QUIET_START_HOUR=22
QUIET_END_HOUR=8
# 补发时限：超过 6 小时的旧通知直接放弃，早上 9 点的提醒下午 4 点才发等于骂人
DIGEST_MAX_DELAY_HOURS=6
# 日报每类（已逾期/今天/明天）最多列几条，超出显示「还有 N 条」
DIGEST_MAX_PER_SECTION=4
# worker.py 的扫描间隔（秒）
WORKER_INTERVAL_SECONDS=60

# 状态变更即时通知（Day 13）
# 1=在卡片回调里起后台线程立刻发；0=只入队，等 worker 下一轮发（测试用）
EVENT_FLUSH_IMMEDIATE=1

# 到期前 24 小时提醒 / 逾期提醒（设计文档 12.3）
# 到期提醒：每任务每期限一次，改了截止时间会重新提醒
# 逾期提醒：首次逾期发一次，之后每 N 个工作日再发；周末不催
# 两个都走发件箱，受上面的免打扰时段约束
# 注意：一条「明天 9 点截止」的任务，当天日报和到期提醒会各提一次，
# 这是设计文档 12.3 就分开列的两类事件；嫌吵可以把其中一个设 0
DUE_REMINDER_ENABLED=1
OVERDUE_REMINDER_ENABLED=1
# 候选创建满 1 小时后仍待补充，仅私聊原消息发起人一次
INFO_REMINDER_ENABLED=1
TASK_INFO_REMINDER_ENABLED=1
OVERDUE_INTERVAL_WORKDAYS=2

# 旧卡片同步（Day 14）
# 1=状态变的时候顺手把这条任务的历史卡片都刷成最新；0=只更新被点的那张
# 关掉只在排障时用：关了就回到「往上翻全是旧状态」的老样子
CARD_SYNC_ENABLED=1
# 刷新后的旧卡上要不要加一句说明，留空=不加（推荐留空）
# 加的话写一句人话，比如「这张卡是历史消息，已同步」
CARD_SYNC_HINT=

# 飞书日历同步（Day 16）
# 开放平台要先开 calendar:calendar（更新日历及日程信息）并创建版本发布，
# 没发版就把它设 0。代码里默认是 0，所以旧 .env 不加这项不会突然调接口。
CALENDAR_SYNC_ENABLED=1
# personal 直接写入已授权的个人主日历；application 为旧版邀请模式
CALENDAR_SYNC_MODE=application
# 开放平台安全设置中登记此地址加 /calendar/callback
CALENDAR_AUTH_BASE_URL=http://127.0.0.1:8766
CALENDAR_AUTH_HOST=127.0.0.1
CALENDAR_AUTH_PORT=8766
# 跨设备部署设为 1，配置 HTTPS 地址后才允许发起用户授权
CALENDAR_AUTH_REQUIRE_PUBLIC=0
# 凭证使用 AES-GCM 加密，默认密钥路径为任务库路径加 .calendar.key
# CALENDAR_TOKEN_KEY_FILE=D:/secure/calendar-token.key
# 日程从「截止前多少分钟」开始占用，结束时间就是截止时间
CALENDAR_LEAD_MINUTES=15
# 飞书 reminders 是相对**日程开始时间**提前的分钟数，不是相对截止时间。
# 0 = 日程开始时提醒（即截止前 15 分钟）；设 -1 = 不传提醒，只靠占用块
CALENDAR_REMINDER_MINUTES=0
# 留空自动查应用主日历。跑 calendar_sync.py --check 能拿到具体值，
# 填进来可以每次少一次查询
FEISHU_CALENDAR_ID=
# 确认建单后同步到负责人飞书任务中心。应用需开通 task:task:write 并发布。
FEISHU_NATIVE_TASK_ENABLED=0
